<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
    <meta name="author" content="Freeze Feast">
    <meta name="description" content="Freeze Feast - Fresh Food Delivered to Your Door">
    <title>Freeze & Feast</title>
    <link rel="shortcut icon" href="assets/images/favicon.svg">
    <link rel="stylesheet" href="assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="assets/css/animate.css">
    <link rel="stylesheet" href="assets/css/swiper-bundle.min.css">
    <link rel="stylesheet" href="assets/css/main.css">
    <link rel="stylesheet" href="assets/css/style.css">
    <link rel="stylesheet" href="assets/css/responsive.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>

<style>

    .user-dropdown {
        position: relative;
        display: inline-block;
    }
    
    .user-btn {
        background: #ff6b6b;
        border: none;
        padding: 10px 12px;
        border-radius: 50%;
        color: white;
        cursor: pointer;
    }
    
    .dropdown-menu {
        display: none;
        position: absolute;
        right: 0;
        top: 45px;
        background: white;
        min-width: 160px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        border-radius: 8px;
        padding: 10px;
        z-index: 999;
    }
    
    .dropdown-menu a {
        display: block;
        padding: 8px;
        text-decoration: none;
        color: #333;
    }
    
    .dropdown-menu a:hover {
        background: #f2f2f2;
    }
    
    .user-name {
        display: block;
        font-weight: bold;
        margin-bottom: 8px;
    }
    

</style>

<body>
    <!-- Mobile Menu Overlay -->
    <div class="ff-mobile-overlay"></div>
    
    <!-- Mobile Menu -->
    <div class="ff-mobile-menu">
        <div class="ff-mobile-menu-header">
            <a href="index.html" class="ff-logo">
                <img src="assets/images/logo.svg" alt="Freeze & Feast">
            </a>
            <button class="ff-mobile-menu-close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <nav class="ff-mobile-nav">
            <a href="index.html" class="ff-mobile-nav-link active">
                <i class="fa-solid fa-house"></i>
                <span>Home</span>
            </a>
            <a href="product-list.html" class="ff-mobile-nav-link">
                <i class="fa-solid fa-th-large"></i>
                <span>Category</span>
            </a>
            <a href="about.html" class="ff-mobile-nav-link">
                <i class="fa-solid fa-info-circle"></i>
                <span>About</span>
            </a>
            <a href="contact.html" class="ff-mobile-nav-link">
                <i class="fa-solid fa-envelope"></i>
                <span>Contact</span>
            </a>
            <a href="cart.html" class="ff-mobile-nav-link">
                <i class="fa-solid fa-cart-shopping"></i>
                <span>Cart</span>
            </a>
        </nav>
        <div class="ff-mobile-menu-divider"></div>
        <div class="ff-mobile-user-section" id="mobileUserSection">
            <!-- Will be populated by JavaScript based on login state -->
        </div>
    </div>

    <!-- Header Section -->
    <header class="ff-header">
        <div class="container">
            <div class="ff-header-wrapper">
                <!-- Logo -->
                <a href="/" class="ff-logo">
                    <img src="assets/images/logo.svg" alt="Freeze Feast">
                </a>

                <!-- Navigation -->
                <nav class="ff-nav d-none d-lg-flex">
                    <a href="/" class="ff-nav-link active">Home</a>
                    <a href="product-list.html" class="ff-nav-link">Category</a>
                    <a href="about.html" class="ff-nav-link">About</a>
                    <a href="contact.html" class="ff-nav-link">Contact</a>
                </nav>

                <!-- User & Cart -->
                <div class="ff-header-right">
                    <!-- Search Icon -->
                    <button class="ff-search-icon-btn" id="headerSearchBtn">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                    
                    <!-- User Menu (Before Login) -->

        <% if (!user) { %>
                <!-- Not Logged In -->
                <a href="/register" class="ff-login-link">
                    <button class="ff-user-btn">
                        <i class="fa-regular fa-user"></i>
                    </button>
                </a>
       <% } else { %>

                <div class="user-dropdown">
                    <button class="user-btn" onclick="toggleDropdown()">
                        <i class="fa-regular fa-user"></i>
                    </button>
                
                    <div id="dropdownMenu" class="dropdown-menu">
                        <span class="user-name"> <%= user.name %></span>
                
                        <a href="#">Profile</a>
                        <a href="/logout">Logout</a>
                    </div>
                </div>
                
                <% } %>
                    

                    <a href="cart.html">
                        <button class="ff-cart-btn">
                            <i class="fa-solid fa-cart-shopping"></i>
                            <span class="ff-cart-count">3</span>
                        </button>
                    </a>
                    <button class="ff-mobile-toggle d-lg-none">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <script>
        function toggleDropdown() {
            const menu = document.getElementById("dropdownMenu");
            menu.style.display = menu.style.display === "block" ? "none" : "block";
        }
        
        // click outside close
        window.onclick = function(e) {
            if (!e.target.closest('.user-dropdown')) {
                document.getElementById("dropdownMenu").style.display = "none";
            }
        }
        
        </script>
        