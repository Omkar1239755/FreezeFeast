
<%- include('../partials/header') %>


<section class="ff-profile-section">
    <div class="container">
        <div class="ff-profile-card">
            <form class="ff-profile-form" id="profileForm">
                <div class="ff-profile-layout">
                    <!-- Profile Avatar -->
                    <div class="ff-profile-avatar-section">
                        <div class="ff-avatar-wrapper">
                            <img src="assets/img/inner/user-avatar.jpg" alt="Profile Avatar" id="avatarPreview" onerror="this.src='https://ui-avatars.com/api/?name=User&background=0066FF&color=fff&size=150'">
                            <label for="avatarUpload" class="ff-avatar-upload-btn">
                                <i class="fa-solid fa-camera"></i>
                            </label>
                            <input type="file" id="avatarUpload" accept="image/*" hidden>
                        </div>
                        <p class="ff-avatar-hint">Click camera to change photo</p>
                    </div>

                    <!-- Profile Form Fields -->
                    <div class="ff-profile-fields">
                        <div class="ff-form-row">
                            <div class="ff-form-group">
                                <label for="firstName">First Name</label>
                                <input type="text" id="firstName" name="firstName" placeholder="Enter First Name" required>
                            </div>
                            <div class="ff-form-group">
                                <label for="lastName">Last Name</label>
                                <input type="text" id="lastName" name="lastName" placeholder="Enter Last Name" required>
                            </div>
                        </div>

                        <div class="ff-form-row">
                            <div class="ff-form-group">
                                <label for="email">Email Address</label>
                                <input type="email" id="email" name="email" placeholder="Enter Email Address" required>
                            </div>
                            <div class="ff-form-group">
                                <label for="phone">Phone Number</label>
                                <input type="tel" id="phone" name="phone" placeholder="Enter Phone Number">
                            </div>
                        </div>

                        <div class="ff-form-row">
                            <div class="ff-form-group">
                                <label for="city">Town/City</label>
                                <input type="text" id="city" name="city" placeholder="Enter Town/City">
                            </div>
                            <div class="ff-form-group">
                                <label for="postcode">Postcode</label>
                                <input type="text" id="postcode" name="postcode" placeholder="Enter Postcode">
                            </div>
                        </div>

                        <div class="ff-form-row ff-form-row-full">
                            <div class="ff-form-group">
                                <label for="address">Address Line 1</label>
                                <textarea id="address" name="address" placeholder="Enter house number/Flat number/Street Name" rows="4"></textarea>
                            </div>
                        </div>

                        <div class="ff-form-actions">
                            <button type="submit" class="ff-submit-btn">
                                <i class="fa-solid fa-check"></i>
                                Save Changes
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>




<%- include('../partials/header') %>